# Пример конфигурации deploy.sh. Скопируйте в .env и заполните.
# Приоритет: CLI-флаги > переменные .env > интерактивный запрос.

# Основной домен: сайт-заглушка, панели 3x-ui и h-ui, WS/XHTTP/Trojan, Hysteria2 TLS
DOMAIN=example.com

# Второй домен: только для SNI/dest VLESS Reality (selfSNI). Сертификат выпускается отдельно.
REALITY_DOMAIN=reality.example.com

# E-mail для Let's Encrypt (пусто = регистрация без email)
LE_EMAIL=

# SSH-порт (пусто = определить автоматически из sshd_config)
SSH_PORT=

# Порт Docker-контейнера MTProto (TCP, не 80/443/22)
MT_PORT=

# Включаемые компоненты: 1/0
ENABLE_XUI=1
ENABLE_HUI=1
ENABLE_MTPROTO=1
ENABLE_WEBPROXY=1

# Добавлять ли inbound VLESS XHTTP (grpc через unix-сокет)
ENABLE_XHTTP=1

# Каталог собственного сайта-заглушки (пусто = встроенный шаблон из assets/site)
SITE_DIR=
